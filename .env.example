# Optional: defaults to the deployed contract 0x59747B1A995EF0Cb01CA6A97CE0aaeA38b2474F4
# VITE_POOL_ADDRESS=
# Private key of the ORACLE wallet (the address you passed as `oracle` when deploying). Server-side only.
ORACLE_PRIVATE_KEY=
# Optional RPC override
# VITE_RPC_URL=https://testnet-rpc.monad.xyz

# Optional: refuse Tier 2/3 health data until a Play Integrity / App Attest verifier is configured
# REQUIRE_DEVICE_ATTESTATION=1

# Optional encrypted cloud journal. Set only on the server; never use a VITE_ prefix for the token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Exact browser origin, including scheme and port. Use the stable production domain in Vercel.
JOURNAL_ORIGIN=http://localhost:5173

# Optional public GraphQL URL after deploying the Envio indexer.
VITE_ENVIO_URL=
